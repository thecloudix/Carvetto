+ ---------------------------------------------------------------------------
+ Carvetto post-processor: Mach3, inches
+ Written for Carvetto from scratch (clean-room). Licensed with Carvetto.
+ Dialect source: the "Using Mach3Mill" user manual (Artsoft / Newfangled Solutions).
+
+ Notes
+ - G20 selects inches; coordinates have four decimals, feeds are inches per minute.
+ - The start line selects absolute distance (G90), units-per-minute feed
+   (G94), incremental arc centres (G91.1, so I/J do not depend on the
+   controller's IJ-mode setting), cancels cutter compensation (G40), tool
+   length offset (G49) and canned cycles (G80), and selects the XY plane (G17).
+ - Tool changes use T<n> M6. The spindle is stopped and the tool lifted to
+   safe Z first; after M6 returns the new tool is lifted to safe Z before any
+   XY move and the spindle is restarted. Add G43 H<n> after M6 if your tool
+   table holds tool length offsets.
+ - !! If Mach3's tool change option (Config > General Config) is set to
+   ignore tool changes, M6 does not pause and the next toolpath runs with
+   the previous tool. Choose the option that stops the spindle and waits
+   for Cycle Start (or use an automatic tool changer).
+ - G4 P is written in SECONDS, Mach3's default. A General Config checkbox
+   (commonly labelled "G04 Dwell in Milliseconds") is reported to switch
+   P to milliseconds; verify it is off on your machine. If it is on, dwells
+   become 1000 times shorter, never longer.
+ - Parentheses start comments, so they are replaced in text values.
+ - Lines that do something are numbered N10, N20, ... as is customary for Mach3.
+ - Lines end with CR LF (Windows).
+ - M30 ends the program and rewinds it.
+ ---------------------------------------------------------------------------

POST_NAME = "Mach3 (inch) (*.tap)"
FILE_EXTENSION = "tap"
UNITS = "INCHES"
LINE_ENDING = "[13][10]"
SUBSTITUTE = "([)]"
LINE_NUMBER_START = 10
LINE_NUMBER_INCREMENT = 10
LINE_NUMBER_MAXIMUM = 999990

+ Variables: VAR NAME = [tag|mode|prefix|format|multiplier]
VAR LINE_NUMBER = [N|A|N|1.0]
VAR TOOL_NUMBER = [T|A||1.0]
VAR SPINDLE_SPEED = [S|A| S|1.0]
VAR FEED_RATE = [F|C| F|1.1]
VAR X_POSITION = [X|C| X|1.4]
VAR Y_POSITION = [Y|C| Y|1.4]
VAR Z_POSITION = [Z|C| Z|1.4]
VAR ARC_CENTRE_I = [I|A| I|1.4]
VAR ARC_CENTRE_J = [J|A| J|1.4]
VAR SAFE_Z = [SAFEZ|A| Z|1.4]
VAR HOME_X = [XH|A| X|1.4]
VAR HOME_Y = [YH|A| Y|1.4]
VAR DWELL_TIME = [DWELL|A| P|1.2]

begin HEADER
"([TP_FILENAME])"
"(Generated by [PRODUCT])"
"[N] G90 G94 G91.1 G40 G49 G80 G17 G20"
"(Tool [T]: [TOOLNAME])"
"[N] T[T] M6"
"[N] G0[SAFEZ]"
"([TOOLPATH_NAME])"
"[N] M3[S]"
end

+ Each further toolpath with a different tool.
begin TOOLCHANGE
"[N] M5"
"[N] G0[SAFEZ]"
"(Tool [T]: [TOOLNAME])"
"[N] T[T] M6"
"[N] G0[SAFEZ]"
"([TOOLPATH_NAME])"
end

begin SPINDLE_ON
"[N] M3[S]"
end

+ A further toolpath with the same tool.
begin NEW_SEGMENT
"([TOOLPATH_NAME])"
"[N] M3[S]"
end

begin RAPID_MOVE
"[N] G0[X][Y][Z]"
end

begin FEED_MOVE
"[N] G1[X][Y][Z][F]"
end

begin PLUNGE_MOVE
"[N] G1[X][Y][Z][F]"
end

begin RETRACT_MOVE
"[N] G0[Z]"
end

begin CW_ARC_MOVE
"[N] G2[X][Y][Z][I][J][F]"
end

begin CCW_ARC_MOVE
"[N] G3[X][Y][Z][I][J][F]"
end

begin DWELL_MOVE
"[N] G4[DWELL]"
end

begin FOOTER
"[N] G0[SAFEZ]"
"[N] M5"
"[N] G0[XH][YH]"
"[N] M30"
end
