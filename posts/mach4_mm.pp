+ ---------------------------------------------------------------------------
+ Carvetto post-processor: Mach4, millimetres
+ Written for Carvetto from scratch (clean-room). Licensed with Carvetto.
+ Dialect source: the Mach4 Mill G-code programming manual (Newfangled Solutions).
+
+ Notes
+ - G21 selects millimetres; feed rates are millimetres per minute.
+ - The start line selects absolute distance (G90), units-per-minute feed
+   (G94), incremental arc centres (G91.1, so I/J do not depend on the
+   controller's IJ-mode setting), cancels cutter compensation (G40), tool
+   length offset (G49) and canned cycles (G80), and selects the XY plane (G17).
+ - Tool changes use T<n> M6. The spindle is stopped and the tool lifted to
+   safe Z first; after M6 returns the new tool is lifted to safe Z before any
+   XY move and the spindle is restarted. Add G43 H<n> after M6 if your tool
+   table holds tool length offsets.
+ - !! What M6 does on Mach4 depends on the profile's tool-change setup (the
+   tool change type and the m6 macro). If tool changes are ignored, M6 does
+   not pause and the next toolpath runs with the previous tool. Make sure M6
+   stops and waits for Cycle Start (or drives an automatic tool changer).
+ - G4 P is written in SECONDS, as the Mach4 Mill G-code manual specifies.
+ - Parentheses start comments, so they are replaced in text values.
+ - Lines end with CR LF (Windows).
+ - M30 ends the program and rewinds it.
+ ---------------------------------------------------------------------------

POST_NAME = "Mach4 (mm) (*.tap)"
FILE_EXTENSION = "tap"
UNITS = "MM"
LINE_ENDING = "[13][10]"
SUBSTITUTE = "([)]"

+ Variables: VAR NAME = [tag|mode|prefix|format|multiplier]
VAR TOOL_NUMBER = [T|A||1.0]
VAR SPINDLE_SPEED = [S|A| S|1.0]
VAR FEED_RATE = [F|C| F|1.0]
VAR X_POSITION = [X|C| X|1.3]
VAR Y_POSITION = [Y|C| Y|1.3]
VAR Z_POSITION = [Z|C| Z|1.3]
VAR ARC_CENTRE_I = [I|A| I|1.3]
VAR ARC_CENTRE_J = [J|A| J|1.3]
VAR SAFE_Z = [SAFEZ|A| Z|1.3]
VAR HOME_X = [XH|A| X|1.3]
VAR HOME_Y = [YH|A| Y|1.3]
VAR DWELL_TIME = [DWELL|A| P|1.2]

begin HEADER
"([TP_FILENAME])"
"(Generated by [PRODUCT])"
"G90 G94 G91.1 G40 G49 G80 G17 G21"
"(Tool [T]: [TOOLNAME])"
"T[T] M6"
"G0[SAFEZ]"
"([TOOLPATH_NAME])"
"M3[S]"
end

+ Each further toolpath with a different tool.
begin TOOLCHANGE
"M5"
"G0[SAFEZ]"
"(Tool [T]: [TOOLNAME])"
"T[T] M6"
"G0[SAFEZ]"
"([TOOLPATH_NAME])"
end

begin SPINDLE_ON
"M3[S]"
end

+ A further toolpath with the same tool.
begin NEW_SEGMENT
"([TOOLPATH_NAME])"
"M3[S]"
end

begin RAPID_MOVE
"G0[X][Y][Z]"
end

begin FEED_MOVE
"G1[X][Y][Z][F]"
end

begin PLUNGE_MOVE
"G1[X][Y][Z][F]"
end

begin RETRACT_MOVE
"G0[Z]"
end

begin CW_ARC_MOVE
"G2[X][Y][Z][I][J][F]"
end

begin CCW_ARC_MOVE
"G3[X][Y][Z][I][J][F]"
end

begin DWELL_MOVE
"G4[DWELL]"
end

begin FOOTER
"G0[SAFEZ]"
"M5"
"G0[XH][YH]"
"M30"
end
