+ ---------------------------------------------------------------------------
+ Carvetto post-processor: Grbl 1.1 laser mode, millimetres
+ Written for Carvetto from scratch (clean-room). Licensed with Carvetto.
+
+ Notes
+ - For a Grbl controller with laser mode enabled ($32=1) and the spindle
+   speed range set to 0..1000 ($30=1000, $31=0): S is the beam power, 10 per
+   cent of power. Carvetto's beam power is a per cent value (0..100); the
+   JET_POWER variable below multiplies it by 10. For another S range, edit
+   the multiplier (S0..S255 uses 2.55).
+ - Beam on is M4 (dynamic power: the laser is off during G0 rapids and
+   scales with the feed while the machine accelerates), beam off is M5.
+   Carvetto writes the power word before the beam comes on and again each
+   time the power changes, and always switches the beam off before a rapid,
+   a tool change and the footer.
+ - A laser has no spindle: laser toolpaths write no spindle start. A
+   toolpath that is not a laser's (an end mill job) still starts the spindle
+   with M3 through SPINDLE_ON.
+ - Z is written as the toolpath has it (focus follows the cut on a laser with
+   a motorised Z). For a fixed-focus laser delete [Z] from the move blocks.
+ - Grbl reads G4 P as seconds.
+ ---------------------------------------------------------------------------

POST_NAME = "Grbl laser (mm) (*.nc)"
FILE_EXTENSION = "nc"
UNITS = "MM"
LINE_ENDING = "[10]"
SUBSTITUTE = "([)]"
LASER_SUPPORT = "YES"

+ Variables: VAR NAME = [tag|mode|prefix|format|multiplier]
VAR TOOL_NUMBER = [T|A||1.0]
VAR SPINDLE_SPEED = [S|A| S|1.0]
VAR JET_POWER_WORD = [JET_POWER|A|S|1.0|10]
VAR FEED_RATE = [F|C| F|1.0]
VAR X_POSITION = [X|C| X|1.3]
VAR Y_POSITION = [Y|C| Y|1.3]
VAR Z_POSITION = [Z|C| Z|1.3]
VAR ARC_CENTRE_I = [I|A| I|1.3]
VAR ARC_CENTRE_J = [J|A| J|1.3]
VAR SAFE_Z = [SAFEZ|A| Z|1.3]
VAR HOME_X = [XH|A| X|1.3]
VAR HOME_Y = [YH|A| Y|1.3]
VAR DWELL_TIME = [DWELL|A| P|1.2]

begin HEADER
"([TP_FILENAME])"
"(Generated by [PRODUCT])"
"(Tool [T]: [TOOLNAME])"
"([TOOLPATH_NAME])"
"G90 G94 G17 G21"
"G0[SAFEZ]"
end

+ Each further toolpath with a different tool (laser module or lens change).
begin TOOLCHANGE
"M5"
"G0[SAFEZ]"
"(Change to tool [T]: [TOOLNAME])"
"M0"
"G0[SAFEZ]"
"([TOOLPATH_NAME])"
end

+ Only written for toolpaths that are not a laser's.
begin SPINDLE_ON
"M3[S]"
end

begin SPINDLE_OFF_PAUSE
"M5"
"G0[SAFEZ]"
"(Spindle stays off for diamond drag tool [T]: [TOOLNAME])"
"(Check that the spindle is stopped or locked, then resume)"
"M0"
"G0[SAFEZ]"
end

begin SPINDLE_UNLOCK_PAUSE
"M5"
"G0[SAFEZ]"
"(Diamond drag tool [T] done: unlock the spindle before it starts again)"
"M0"
"G0[SAFEZ]"
end

begin NEW_SEGMENT
"([TOOLPATH_NAME])"
end

begin RAPID_MOVE
"G0[X][Y][Z]"
end

begin FEED_MOVE
"G1[X][Y][Z][F]"
end

begin PLUNGE_MOVE
"G1[X][Y][Z][F]"
end

begin RETRACT_MOVE
"G0[Z]"
end

begin CW_ARC_MOVE
"G2[X][Y][Z][I][J][F]"
end

begin CCW_ARC_MOVE
"G3[X][Y][Z][I][J][F]"
end

begin DWELL_MOVE
"G4[DWELL]"
end

+ Beam switching of laser toolpaths: power first, then on; off before any rapid.
begin JET_TOOL_POWER
"[JET_POWER]"
end

begin JET_TOOL_ON
"M4"
end

begin JET_TOOL_OFF
"M5"
end

begin FOOTER
"G0[SAFEZ]"
"M5"
"G0[XH][YH]"
"M30"
end
