+ ---------------------------------------------------------------------------
+ Carvetto post-processor: Grbl 1.1, millimetres
+ Written for Carvetto from scratch (clean-room). Licensed with Carvetto.
+
+ Notes
+ - Grbl has no automatic tool changer: a tool change stops the spindle,
+   retracts to safe Z and pauses with M0 so the operator can swap the cutter.
+   After the pause the new tool is lifted to safe Z (the operator may have
+   re-zeroed Z on the work surface) before the spindle restarts.
+ - G4 P is a dwell in seconds on Grbl.
+ - Parentheses start comments in Grbl, so they are replaced in text values.
+ - Arcs use G2/G3 with I/J relative to the arc start (G91.1 is Grbl's default).
+ ---------------------------------------------------------------------------

POST_NAME = "Grbl (mm) (*.nc)"
FILE_EXTENSION = "nc"
UNITS = "MM"
LINE_ENDING = "[10]"
SUBSTITUTE = "([)]"

+ Variables: VAR NAME = [tag|mode|prefix|format|multiplier]
VAR TOOL_NUMBER = [T|A||1.0]
VAR SPINDLE_SPEED = [S|A| S|1.0]
VAR FEED_RATE = [F|C| F|1.0]
VAR X_POSITION = [X|C| X|1.3]
VAR Y_POSITION = [Y|C| Y|1.3]
VAR Z_POSITION = [Z|C| Z|1.3]
VAR ARC_CENTRE_I = [I|A| I|1.3]
VAR ARC_CENTRE_J = [J|A| J|1.3]
VAR SAFE_Z = [SAFEZ|A| Z|1.3]
VAR HOME_X = [XH|A| X|1.3]
VAR HOME_Y = [YH|A| Y|1.3]
VAR DWELL_TIME = [DWELL|A| P|1.2]

begin HEADER
"([TP_FILENAME])"
"(Generated by [PRODUCT])"
"(Tool [T]: [TOOLNAME])"
"([TOOLPATH_NAME])"
"G90 G94 G17 G21"
"G0[SAFEZ]"
"M3[S]"
end

+ Each further toolpath with a different tool.
begin TOOLCHANGE
"M5"
"G0[SAFEZ]"
"(Change to tool [T]: [TOOLNAME])"
"M0"
"G0[SAFEZ]"
"([TOOLPATH_NAME])"
end

begin SPINDLE_ON
"M3[S]"
end

+ A further toolpath with the same tool.
begin NEW_SEGMENT
"([TOOLPATH_NAME])"
"M3[S]"
end

begin RAPID_MOVE
"G0[X][Y][Z]"
end

begin FEED_MOVE
"G1[X][Y][Z][F]"
end

begin PLUNGE_MOVE
"G1[X][Y][Z][F]"
end

begin RETRACT_MOVE
"G0[Z]"
end

begin CW_ARC_MOVE
"G2[X][Y][Z][I][J][F]"
end

begin CCW_ARC_MOVE
"G3[X][Y][Z][I][J][F]"
end

begin DWELL_MOVE
"G4[DWELL]"
end

begin FOOTER
"G0[SAFEZ]"
"M5"
"G0[XH][YH]"
"M30"
end
