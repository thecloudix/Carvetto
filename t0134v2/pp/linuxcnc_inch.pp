+ ---------------------------------------------------------------------------
+ Carvetto post-processor: LinuxCNC, inches
+ Written for Carvetto from scratch (clean-room). Licensed with Carvetto.
+ Dialect source: the LinuxCNC G-code reference (linuxcnc.org/docs/html/gcode/).
+
+ Notes
+ - G20 selects inches; coordinates have four decimals, feeds are inches per minute.
+ - The start line cancels cutter compensation (G40), tool length offset
+   (G49) and canned cycles (G80), selects the XY plane (G17), absolute
+   distance (G90), incremental arc centres (G91.1) and units-per-minute feed
+   (G94).
+ - Tool changes use T<n> M6 followed by G43 H<n>, so the tool length offset
+   from the tool table is applied. The spindle is stopped and the old tool
+   lifted to safe Z first; after the change the new tool is lifted to safe Z
+   (with its own offset) before any XY move, then the spindle is restarted.
+ - G4 P is a dwell in seconds on LinuxCNC.
+ - Parentheses start comments, so they are replaced in text values.
+ - M2 ends the program (spindle off, coolant off, modal state reset).
+ ---------------------------------------------------------------------------

POST_NAME = "LinuxCNC (inch) (*.ngc)"
FILE_EXTENSION = "ngc"
UNITS = "INCHES"
LINE_ENDING = "[10]"
SUBSTITUTE = "([)]"

+ Variables: VAR NAME = [tag|mode|prefix|format|multiplier]
VAR TOOL_NUMBER = [T|A||1.0]
VAR SPINDLE_SPEED = [S|A| S|1.0]
VAR FEED_RATE = [F|C| F|1.1]
VAR X_POSITION = [X|C| X|1.4]
VAR Y_POSITION = [Y|C| Y|1.4]
VAR Z_POSITION = [Z|C| Z|1.4]
VAR ARC_CENTRE_I = [I|A| I|1.4]
VAR ARC_CENTRE_J = [J|A| J|1.4]
VAR SAFE_Z = [SAFEZ|A| Z|1.4]
VAR HOME_X = [XH|A| X|1.4]
VAR HOME_Y = [YH|A| Y|1.4]
VAR DWELL_TIME = [DWELL|A| P|1.2]

begin HEADER
"([TP_FILENAME])"
"(Generated by [PRODUCT])"
"G17 G40 G49 G80 G90 G91.1 G94 G20"
"(Tool [T]: [TOOLNAME])"
"T[T] M6"
"G43 H[T]"
"G0[SAFEZ]"
"([TOOLPATH_NAME])"
"M3[S]"
end

+ Each further toolpath with a different tool.
begin TOOLCHANGE
"M5"
"G0[SAFEZ]"
"(Tool [T]: [TOOLNAME])"
"T[T] M6"
"G43 H[T]"
"G0[SAFEZ]"
"([TOOLPATH_NAME])"
end

begin SPINDLE_ON
"M3[S]"
end

+ A further toolpath with the same tool.
begin NEW_SEGMENT
"([TOOLPATH_NAME])"
"M3[S]"
end

begin RAPID_MOVE
"G0[X][Y][Z]"
end

begin FEED_MOVE
"G1[X][Y][Z][F]"
end

begin PLUNGE_MOVE
"G1[X][Y][Z][F]"
end

begin RETRACT_MOVE
"G0[Z]"
end

begin CW_ARC_MOVE
"G2[X][Y][Z][I][J][F]"
end

begin CCW_ARC_MOVE
"G3[X][Y][Z][I][J][F]"
end

begin DWELL_MOVE
"G4[DWELL]"
end

begin FOOTER
"G0[SAFEZ]"
"M5"
"G0[XH][YH]"
"M2"
end
